  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrderTrackingApp.Blazor.Client\OrderTrackingApp.Blazor.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
